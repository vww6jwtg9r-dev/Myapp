{
  "expo": {
    "name": "RideReserve",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobilityreserve.rihidb",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload profile and vehicle photos",
        "NSCameraUsageDescription": "Capture profile and vehicle photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B192C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.mobilityreserve.rihidb",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B192C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose profile and vehicle photos",
          "cameraPermission": "Take profile and vehicle photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
